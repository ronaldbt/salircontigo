{
  "name": "citasi",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  // Crea la base con: npx wrangler d1 create citasi
  // Pega aquí el database_id que devuelva. Este uuid solo sirve en local.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "citasi",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
